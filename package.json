{
  "name": "@juners/csv-stream",
  "version": "1.0.1",
  "description": "Parse and stringify CSV with Web Streams",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rfc4180": {
      "types": "./dist/rfc4180.d.ts",
      "default": "./dist/rfc4180.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test:watch": "vitest watch --coverage",
    "test": "vitest run --coverage --coverage.reporter=cobertura --coverage.reporter=text",
    "lint": "npx --node-options='--experimental-strip-types' eslint --flag unstable_native_nodejs_ts_config",
    "build": "vite build && tsc --project tsconfig.build.json",
    "clean": "node utils/remove.ts -- -f ./dist -f ./TestResults"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juner/csv-stream.git"
  },
  "keywords": [
    "csv",
    "stream",
    "web streams",
    "TransformStream",
    "parse",
    "stringify"
  ],
  "author": "juners",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/juner/csv-stream/issues"
  },
  "homepage": "https://github.com/juner/csv-stream#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/fs-extra": "^11.0.4",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.1",
    "fs-extra": "^11.3.2",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
